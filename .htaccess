# Pages, scripts and styles change often: phones must check for a newer copy every time
# (an unchanged file still comes back as a quick "not modified", so this costs almost nothing).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# The site moved to raffaelco.com/DM/. In the old ridge-games copy, pages forward there (same path and query);
# .php files keep answering, because the media Worker still checks logins at ridge-games/social.php.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/ridge-games(/|$)
  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^(.*)$ /DM/$1 [R=302,L]
</IfModule>
